{
  "name": "redwords",
  "version": "3.0.0-next.1",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.development vite dev",
    "build": "dotenv -e .env.development vite build",
    "preview": "dotenv -e .env.development vite preview",
    "test": "pnpm run test:integration && pnpm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . --plugin 'prettier-plugin-svelte' && eslint .",
    "format": "prettier . --write . --plugin 'prettier-plugin-svelte'",
    "test:integration": "playwright test",
    "test:unit": "vitest",
    "release": "semantic-release",
    "db:introspect": "dotenv -e .env.development -- drizzle-kit introspect",
    "db:generate": "dotenv -e .env.development -- drizzle-kit generate",
    "db:push": "dotenv -e .env.development -- drizzle-kit push",
    "db:migrate": "dotenv -e .env.development -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.development -- drizzle-kit studio"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.251",
    "@playwright/test": "^1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/eslint-plugin-tailwindcss": "^3.17.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-jsdoc": "^65.4.3",
    "eslint-plugin-svelte": "^3.24.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prisma": "^5.19.1",
    "semantic-release": "^25.0.9",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "ts-node": "^10.9.2",
    "tslib": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-icons": "^24.0.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.7",
    "wrangler": "4.158.0"
  },
  "type": "module",
  "release": {
    "branches": [
      "main",
      {
        "name": "next",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json"
          ]
        }
      ],
      "@semantic-release/github"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.654.0",
    "@aws-sdk/credential-providers": "^3.654.0",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^5.19.1",
    "@prisma/client": "^5.19.1",
    "drizzle-orm": "^0.45.4",
    "eslint-plugin-drizzle": "^0.2.3",
    "svelte-table": "^0.6.3"
  }
}
